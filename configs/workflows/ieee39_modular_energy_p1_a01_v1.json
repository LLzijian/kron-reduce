{
  "workflow": "ieee39_modular_energy_p1_a01_v1",
  "initial_stage": "scaffold",
  "stages": [
    "scaffold",
    "plan_registered",
    "candidate_acquired",
    "model_unit_gate",
    "source_commit",
    "controlled_experiment",
    "residual_diagnosis",
    "adversarial_review",
    "acceptance",
    "merge_gate",
    "rollback_report",
    "report"
  ],
  "transitions": {
    "scaffold": "plan_registered",
    "plan_registered": "candidate_acquired",
    "candidate_acquired": "model_unit_gate",
    "model_unit_gate": "source_commit",
    "source_commit": "controlled_experiment",
    "controlled_experiment": "residual_diagnosis",
    "residual_diagnosis": "adversarial_review",
    "adversarial_review": "acceptance",
    "acceptance": {
      "ACCEPT": "merge_gate",
      "REJECT": "rollback_report",
      "RETRY": "rollback_report"
    },
    "merge_gate": "report",
    "rollback_report": "report"
  },
  "terminal_stages": ["report"],
  "approval_required": ["merge_gate"],
  "stage_evidence_contracts": {
    "acceptance": {
      "required_fields": ["status", "process_status", "scientific_verdict", "promotion_decision", "rollback_target", "claim_boundary", "paper_usable_claims"],
      "allowed_values": {
        "promotion_decision": ["KEEP_BASELINE"]
      }
    },
    "rollback_report": {
      "required_fields": ["status", "process_status", "scientific_verdict", "promotion_decision", "rollback_target", "negative_evidence_run", "next_hypothesis"],
      "allowed_values": {
        "promotion_decision": ["KEEP_BASELINE"]
      }
    },
    "report": {
      "required_fields": ["status", "branch_terminal", "acceptance_run", "artifact_hashes", "report_path"],
      "allowed_values": {
        "branch_terminal": ["merge_gate", "rollback_report"]
      },
      "non_empty_fields": ["acceptance_run", "artifact_hashes", "report_path"],
      "conditional_required_fields": {
        "branch_terminal": {
          "merge_gate": ["merge_commit"],
          "rollback_report": ["rollback_target", "negative_evidence_run"]
        }
      }
    }
  },
  "scientific_target": "p1_current_ten_machine_implementation_diagnosis",
  "locked_claims": [
    "test_assisted_selection",
    "source_routing",
    "multiple_models_for_one_input_corpus",
    "future_observed_Pm_as_primary_input",
    "modal_claim_from_fewer_than_three_independent_lines",
    "threshold_relaxation_after_results",
    "promotion_without_acceptance"
  ]
}
